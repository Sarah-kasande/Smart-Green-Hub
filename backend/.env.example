# Names only. Never commit real values.
# Local development: put local-database overrides in .env.local (see README). Tests use .env.test.

# Server
PORT=
NODE_ENV=
CORS_ORIGIN=
# Number of proxies in front of the API, used for rate limiting: 2 on Render (Vercel rewrite + Render
# load balancer), 1 when the API runs on Vercel, empty locally.
TRUST_PROXY=

# Database (Aiven MySQL in production)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Set to false only for the local MySQL in Docker
DB_SSL=
# CA certificate text (Render) or a file path (local only)
DB_CA_CERT=
DB_CA_PATH=

# Authentication
JWT_SECRET=
# Optional: secret for hashing the 6-digit email codes (HMAC). If empty, JWT_SECRET is used.
OTP_SECRET=

# First administrator (created automatically on startup if no administrator exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email through the Brevo HTTP API. Without BREVO_API_KEY (development only) emails are printed to the
# console and marked "skipped". The key must be allowed to send transactional email in Brevo.
BREVO_API_KEY=
# A sender address VERIFIED in Brevo, written as: Smart Green Hub <you@example.com>
MAIL_FROM=
# Public address of the frontend, used in email links (e.g. the Vercel URL)
APP_URL=

# Vercel only: random text (at least 16 characters). Vercel Cron sends it to /api/cron/nightly;
# the nightly job runs only with this secret. Not needed locally or on Render (node-cron is used there).
CRON_SECRET=

# Testing only (never set on Render)
# ENV_FILE: load only this file (used by scripts/start-e2e.js with .env.e2e)
# EMAIL_OUTBOX_FILE: write emails to this file instead of the console (end-to-end tests)
